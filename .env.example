# Copy to .env and fill in. A real environment variable always wins over this
# file, so `DEEPGRAM_API_KEY=... videotranscriptor talk.mp4` still overrides it.
# .env is gitignored - never commit a real key.

# Cloud approach. Get one at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Local approach (optional). Where NeMo caches downloaded checkpoints;
# defaults to ~/.cache/torch/NeMo. Point it at a bigger disk if needed.
# NEMO_CACHE_DIR=
